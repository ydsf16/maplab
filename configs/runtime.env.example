# Copy to .phoneai.env to override the portable defaults in scripts/phoneai_env.sh.
# Keep recordings, models and results on AutoDL's data disk when available.
PHONE_AI_DATA_DIR=/root/data
PHONE_AI_RECORDINGS_DIR=/root/data/recordings
PHONE_AI_RUNTIME_DIR=/root/.local/share/phone-ai/runtime
PHONE_AI_MODELS_DIR=/root/data/phone-ai-models
