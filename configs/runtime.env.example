# Copy to .phoneai.env to override the portable defaults in scripts/phoneai_env.sh.
# Keep recordings, models and results on AutoDL's data disk when available.
PHONE_AI_DATA_DIR=/root/autodl-tmp/phone-ai-data
PHONE_AI_RECORDINGS_DIR=/root/autodl-tmp/phone-ai-data/recordings
PHONE_AI_RUNTIME_DIR=/root/autodl-tmp/phone-ai-data/runtime
PHONE_AI_MODELS_DIR=/root/autodl-tmp/phone-ai-data/models
